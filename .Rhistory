data <- read.csv("bodyPerformance.csv")
str(data)
unique(data$gender)
unique(data$class)
summary(data)
library(ggplot2)
library(tidyr)
library(dplyr)
data_num <- data %>%
select(where(is.numeric))
#We transform the data to long format, which means that there will be a column for the fariables and a column for the values.
data_num1 <- data_num %>%
select(1:2)
data_num2 <- data_num %>%
select(3:4)
data_num3 <- data_num %>%
select(5:6)
data_num4 <- data_num %>%
select(7:8)
data_num5 <- data_num %>%
select(9:10)
long_data <- data_num5 %>%
pivot_longer(cols = everything(),
names_to = "variable",
values_to = "value")
plot <- ggplot(long_data, aes(x = value)) +
geom_histogram(bins = 30,
fill = "steelblue",
color = "white") +
facet_wrap(~variable, scales = "free", ncol = 2) +
theme_minimal() +
theme(
axis.title = element_text(size = 20),
axis.text = element_text(size = 20),
strip.text = element_text(size = 20, face = "bold")
) +
labs(
x = "Value",
y = "Frequency")
#14 good height
ggsave("distributions5.png",
plot = plot,
width = 16,
height = 8,
units = "in",
dpi = 120)
